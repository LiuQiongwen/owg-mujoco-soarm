<mujoco model="Piper workspace scene">
    <include file="robot.xml"/>

    <statistic center="0.3 0 0.1" extent="0.8"/>

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="120" elevation="-20"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
                 markrgb="0.8 0.8 0.8" width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
        <material name="table_mat" rgba="0.35 0.35 0.38 1"/>
        <material name="tray_mat" rgba="0.2 0.6 0.3 0.5"/>
        <material name="obj_mat" rgba="0.8 0.3 0.2 1"/>
    </asset>

    <worldbody>
        <light pos="0.3 0 1.5" dir="0 0 -1" directional="true"/>
        <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" pos="0 0 -0.5"/>

        <!-- Table: arm base (base_link, robot.xml) sits at world origin z=0, so
             the table surface is placed at z=0 too (arm mounted flush on the
             table). Workspace target region placed at x~0.3-0.45m forward of
             the base -- well within Piper's ~626mm reach, matching the scale
             hinted at by Piper_mujoco's own demo IK target ([0.4, 0, 0.20]). -->
        <geom name="table_top" type="box" size="0.35 0.35 0.02" pos="0.35 0 -0.02" material="table_mat"/>

        <!-- Tray (placement target zone), off to one side -->
        <geom name="tray" type="box" size="0.08 0.08 0.002" pos="0.3 -0.25 0.002" material="tray_mat" contype="0" conaffinity="0"/>

        <!-- One free-floating graspable object (simple box primitive for the
             first IK-reachability smoke test -- not a YCB mesh yet). -->
        <body name="test_object" pos="0.35 0.05 0.03">
            <freejoint/>
            <geom name="test_object_geom" type="box" size="0.02 0.02 0.03" material="obj_mat" mass="0.05"/>
        </body>
    </worldbody>
</mujoco>
