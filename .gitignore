# ---- Python ----
__pycache__/
*.pyc
.ipynb_checkpoints/
*.pyo

# ---- Local logs & outputs (do NOT commit) ----
logs/
results/
semantic_pc/

# ---- Generated datasets (do NOT commit) ----
data/pc/
data/grasps_raw/
data/grasps_val/
grasp_6dof/dataset/
grasp_6dof/out/
grasp_6dof/pc/

# ---- Large datasets / third-party weights (do NOT commit) ----
YCB_Dataset/
cornell-randsplit-*/
third_party/grconvnet/

# ---- Videos / large media ----
*.mp4
*.avi
*.mov

# ---- OS ----
.DS_Store
autoresearch.log
data/transitions/
*.npz
*.pkl

# ---- Claude Code worktrees (do NOT commit) ----
# Nested git worktree checkouts created by the harness for isolated session
# work (each one is a full repo copy, easily 100s of MB) — session-local,
# never meant to be committed.
.claude/worktrees/

# ---- Model checkpoints (do NOT commit) ----
# Large binary weights. Intentionally does NOT match *_stats.json sidecar
# metadata files (normalization stats etc.) — those stay committable.
*.pt
*.pth
*.ckpt

# ---- Recorded hardware/sim data (do NOT commit) ----
# Grows with every trial/episode collected; not source, not a small result.
data/lerobot/
trajs/
paperA_data/lerobot_datasets/
tango_robot/piper_robosuite/piper_trajs/

# ---- TANGO Experiment Agent runtime artifacts (do NOT commit) ----
# Project-local virtualenv (kept separate from the shared `tango` conda env)
# and per-run output directories -- both are regenerated, never source.
/.venv/
/research_agent_runs/
# setuptools build byproducts from `pip install .` (pyproject.toml)
/build/
*.egg-info/

# ---- Build byproducts: LaTeX / console logs (do NOT commit) ----
# Regenerated on every compile/run; not meant to be diffed or reviewed.
*.aux
*.log
*.out
*.fdb_latexmk
*.fls
MUJOCO_LOG.TXT

# ---- Pose-visualization renders (do NOT commit) ----
# Scoped to these exact filenames rather than a blanket *.png — 45 PNGs are
# already tracked under plots/ and media/ and must stay committable.
/cfm_all_poses.png
/cfm_all_poses_ot.png
/cfm_banana_poses.png
/ddpm_all_poses.png

# Agent runtime artifacts
.agents/runs/*
!.agents/runs/.gitignore
!.agents/runs/.gitkeep
.agents/state.json
.agents/claude_report.md
.agents/codex_plan.md
.agents/codex_review.md
.agents/config.sh
.agents/run_research_loop.sh
.agents/task.md

.venv-research-agent/

# --- generated research artifacts and build products (history cleanup 2026-08-08) ---

# Raw camera captures
/cameras/captures/

# Paper build products
/paper_final.pdf
/paper_tro.pdf
/paper_final.aux
/paper_final.log
/paper_final.out

# Reproducibly generated TRO figures
/figures/fig_critic_results.pdf
/figures/fig_offline_vs_live_consistency.pdf

# World-model and Paper A trial data
/paperA_data/worldmodel_trajs/
/paperA_data/phase0_diag_extended/*.jsonl
/paperA_data/phase0_diag_extended/data_with_contact_feats_new3.json
/paperA_data/phase0_diag_extended/data_with_lateral_score_powerdrill.json
/paperA_data/phase0_diag_extended/ui_grasp_exec_snapshot_new3.jsonl
/paperA_data/phase1_matched_n10/*.jsonl
/paperA_data/phase1_v2/*.jsonl
/paperA_data/formal_results/*.csv

# Generated diagnostic outputs; retain approved compact Phase 2Y summaries
/outputs/*
!/outputs/phase2y_4d_cross_instance_audit_summary.json
!/outputs/phase2y_5a_clearance_qualification.json
!/outputs/phase2y_5b_dynamic_clearance_summary.json
!/outputs/phase2y_clearance_uniformity.json
!/outputs/phase2y_gate3_endpoint_summary.json

# Generated Piper experiment results
/tango_robot/piper_robosuite/consensus_results_*.json
/tango_robot/piper_robosuite/experiment_results_*.json
/tango_robot/piper_robosuite/final_pilot_*.json
/tango_robot/piper_robosuite/pairwise_results_*.json
/tango_robot/piper_robosuite/pairwise_results_v2_*.json
/tango_robot/piper_robosuite/stage2_results.json
/tango_robot/piper_robosuite/stage2_v2_results.json

# Generated research-agent evaluation products; retain approved report/table files
# (per the KEEP ruling on the four human-readable files in this subtree)
# '/dir/*' not '/dir/': git will not descend into an excluded directory, so
# negations for files inside one never take effect.
/research_agent_pilots/lggsn_analysis/outputs/*
!/research_agent_pilots/lggsn_analysis/outputs/power_analysis.md
!/research_agent_pilots/lggsn_analysis/outputs/statistical_summary.md
!/research_agent_pilots/lggsn_analysis/outputs/tables/
/research_agent_pilots/lggsn_analysis/outputs/tables/*
!/research_agent_pilots/lggsn_analysis/outputs/tables/pairwise_summary.tex
!/research_agent_pilots/lggsn_analysis/outputs/tables/per_query_breakdown.tex
/research_agent_pilots/lggsn_analysis/pair_results/
/research_agent_pilots/lggsn_suite/eval_outputs/

# Generated intermediate statistics and agent state
/results/**/intermediate_stats_*.json
/REVIEW_STATE.json
*.bak
